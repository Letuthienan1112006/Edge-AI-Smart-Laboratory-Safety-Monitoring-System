# /etc/systemd/system/labsafe-ramlog.service -- RAM / temperature logger for the live service, started at every boot (needs no network).
# Installed by scripts/board/install_ramlog_service.sh. One CSV per boot: runs/ramlog/ram-boot<N>.csv (N counts the files; the board clock is not reliable).
[Unit]
Description=LabSafe RAM logger (reads /proc of labsafe-live; outside the inference process)
After=labsafe-live.service

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/AI_Challenge
ExecStart=/bin/bash scripts/board/ram_logger_boot.sh
Restart=on-failure
RestartSec=10
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=labsafe-ramlog

[Install]
WantedBy=multi-user.target
